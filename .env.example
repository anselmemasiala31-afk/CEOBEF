# Development defaults. Copy this file to .env and adjust before deployment.
# Render uses SECRET_KEY, DEBUG, ALLOWED_HOSTS; PythonAnywhere uses PYTHONANYWHERE=true.
# Never copy a production secret from this example.
DJANGO_SECRET_KEY=replace-with-a-new-random-secret-before-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# SECRET_KEY=
# DEBUG=False
# ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_TRUST_PROXY_SSL=false
CSRF_TRUSTED_ORIGINS=
SECURE_HSTS_SECONDS=0

# Leave DATABASE_URL empty to use SQLite. Production example:
# DATABASE_URL=postgresql://ceobef:replace-me@127.0.0.1:5432/ceobef
DATABASE_URL=
DB_SSLMODE=prefer

# PythonAnywhere Free WSGI profile (set these in its Web app environment or .env).
# PYTHONANYWHERE=true
# SECRET_KEY=generate-a-random-secret-at-least-50-characters
# DEBUG=False
# ALLOWED_HOSTS=yourusername.pythonanywhere.com
# CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_TRUST_PROXY_SSL=true
# CHANNEL_LAYER=memory
# SQLITE_PATH=/home/yourusername/CEOBEF/db.sqlite3
# STATIC_ROOT=/home/yourusername/CEOBEF/staticfiles
# MEDIA_ROOT=/home/yourusername/CEOBEF/private-media

# In-memory layer is for one-process development/PythonAnywhere WSGI only. Render uses its Redis-compatible Key Value service.
# REDIS_URL=redis://127.0.0.1:6379/0
REDIS_URL=

# Development uses Django's console email backend. For SMTP Gmail, set:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=your-organization@gmail.com
# EMAIL_HOST_PASSWORD=your-16-character-google-app-password
# DEFAULT_FROM_EMAIL=CEOBEF <your-organization@gmail.com>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=CEOBEF <noreply@ceobef.org>
